# Local web runs at http://127.0.0.1:5050. Generate a random password (16+ characters).
RENTAL_ADMIN_PASSWORD=
# Optional, at least 32 random characters. Keeps sessions valid across restarts.
# Leave blank for a fresh in-memory signing key on every start.
RENTAL_SESSION_SECRET=
RENTAL_DB_PATH=data/rental.db
# Set to 1 when accessing the dashboard over HTTPS.
RENTAL_COOKIE_SECURE=0

# Optional. Use the project's dedicated Hermes API, with native vision and toolsets disabled.
RENTAL_HERMES_URL=
RENTAL_HERMES_KEY=
RENTAL_HERMES_MODEL=hermes-agent

# Enable enrollment and house-scoped matching with the /internal/embeddings endpoint.
RENTAL_FACE_EMBED_URL=
RENTAL_FACE_API_KEY=
# Optional in split-service setups. The combined launcher sets this automatically.
RENTAL_FACE_PAD_URL=
# Optional: device ID allowed to auto-pulse the onboard LED in a supervised demo.
RENTAL_PAD_DEMO_DEVICE=
# Optional, legacy count-only endpoint. Only used when the embedding endpoint is unset.
RENTAL_FACE_API_URL=

# Optional. Set the private destination Chat ID per house in the manager dashboard.
RENTAL_TELEGRAM_BOT_TOKEN=

# Optional WebRTC servers. TURN URLs are comma-separated and use a shared REST secret.
RENTAL_INTERCOM_STUN_URL=
RENTAL_INTERCOM_TURN_URLS=
RENTAL_INTERCOM_TURN_SECRET=
